# DeepSearch Configuration Specification (§DS-06)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
API_KEY=dev-secret

DATABASE_URL=postgresql+asyncpg://deepsearch:deepsearch@localhost:5432/deepsearch
STORAGE_PATH=./data
MAX_DOWNLOAD_SIZE_MB=100

BROWSER_ENABLED=true
BROWSER_MAX_CONCURRENCY=2
BROWSER_TIMEOUT_SECONDS=45
CHROME_PATH=

OPENALEX_EMAIL=
UNPAYWALL_EMAIL=
CROSSREF_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
ENABLE_ARXIV=true

RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

ORCHESTRATION_BACKEND=axiom
RETRIEVAL_BACKEND=qdrant
VISUAL_RETRIEVAL=disabled
ORCHESTRATOR_URL=http://localhost:8081
ORCHESTRATOR_TOKEN=adgo-dev-token

CAS_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=deepsearch-cas
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

DISTRIBUTED_QUEUE_BACKEND=memory
SESSION_VAULT_KEY=deepsearch-master-secret-key-32b!
SESSION_VAULT_PATH=./data/sessions.vault
