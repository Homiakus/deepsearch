APP_ENV=development
HTTP_ADDR=:8080
API_KEY=dev-secret

DATABASE_URL=postgres://deepsearch:deepsearch@localhost:5432/deepsearch?sslmode=disable
STORAGE_PATH=./data
MAX_DOWNLOAD_SIZE_MB=100

GROBID_URL=http://localhost:8070
BROWSER_ENABLED=true
BROWSER_MAX_CONCURRENCY=2
BROWSER_TIMEOUT_SECONDS=45
CHROME_PATH=

OPENALEX_EMAIL=
UNPAYWALL_EMAIL=
CROSSREF_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
ENABLE_ARXIV=true

FIRECRAWL_ENABLED=false
FIRECRAWL_BASE_URL=http://localhost:3002
FIRECRAWL_API_KEY=

EMBEDDINGS_ENABLED=false
EMBEDDINGS_BASE_URL=http://localhost:4000/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

LLM_ENABLED=false
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
